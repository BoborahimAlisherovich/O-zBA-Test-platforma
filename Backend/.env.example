SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Subdomeningizni kiriting, masalan: test.example.com
ALLOWED_HOSTS=test.example.com

# Frontend va backend bir xil subdomenda bo'lsa shu domenni yozing.
# Agar frontend boshqa subdomenda bo'lsa shu yerga frontend domenini kiriting.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://test.example.com
CSRF_TRUSTED_ORIGINS=https://test.example.com

DATABASE_ENGINE=postgres
POSTGRES_DB=artedu_test
POSTGRES_USER=artedu_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Faqat eski sqlite ma'lumotni ko'chirish uchun kerak bo'ladi.
LEGACY_SQLITE_PATH=./db.sqlite3

MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
